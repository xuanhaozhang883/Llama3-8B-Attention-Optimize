#!/bin/bash
# One-time global setup for Cursor/VS Code Verilog-HDL iverilog linting.
# Copy this directory to ~/.local/bin/verilog-project-iverilog and set:
#   "verilog.linting.path": "/Users/<you>/.local/bin/verilog-project-iverilog"
#
# Then every workspace auto-discovers RTL dirs; no per-project settings.json needed.

REAL_IVERILOG="${REAL_IVERILOG:-/opt/homebrew/bin/iverilog}"

TARGET=""
PASS=()
for arg in "$@"; do
  if [[ "$arg" == *.v || "$arg" == *.sv ]]; then
    TARGET="$arg"
  else
    PASS+=("$arg")
  fi
done

if [[ -z "$TARGET" || ! -f "$TARGET" ]]; then
  exec "$REAL_IVERILOG" "$@"
fi

# Skip snippet files that are not standalone modules.
grep -Eq '^[[:space:]]*module[[:space:]]+' "$TARGET" || exit 0

Y_ARGS=()
while IFS= read -r dir; do
  Y_ARGS+=(-y "$dir" -Y .v -Y .sv)
done < <(
  find . -type f \( -name '*.v' -o -name '*.sv' \) \
    ! -path '*/vivado_synth_*/*' \
    ! -path '*/vivado_*_sim/*' \
    ! -path '*/node_modules/*' \
    ! -name 'glbl.v' \
    -exec dirname {} \; | sort -u
)

EXTRA=()
while IFS= read -r f; do
  EXTRA+=("$f")
done < <(
  find . -type f \( -name '*behavioral*.sv' -o -name '*_stub*.v' -o -name '*_stub*.sv' \) \
    ! -path '*/vivado_synth_*/*' \
    ! -path '*/vivado_*_sim/*' 2>/dev/null
)

exec "$REAL_IVERILOG" -g2012 "${Y_ARGS[@]}" "${EXTRA[@]}" "${PASS[@]}" "$TARGET" 2>&1
